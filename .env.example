POSTGRES_DB=apiguardx
POSTGRES_USER=apiguardx
POSTGRES_PASSWORD=change-me
# Local development: SQLite is enough. Docker Compose uses Postgres at host `db`.
DATABASE_URL=sqlite:///./apiguardx.db

# Use a unique 32+ character secret in production. Never commit real secrets.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=apiguardx
JWT_AUDIENCE=apiguardx-api
JWT_EXPIRE_MINUTES=60

# Use explicit origins in production. Do not use * with credentials.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
NEXT_PUBLIC_API_URL=http://localhost:8000

APP_DEBUG=false
ENVIRONMENT=development

# Scanner SSRF controls. Keep private networks disabled unless scanning an explicitly authorized internal lab.
SCANNER_ALLOWED_HOSTS=
SCANNER_BLOCKED_HOSTS=localhost,*.localhost,127.*,0.0.0.0,::1,169.254.169.254,100.100.100.200
SCANNER_ALLOW_PRIVATE_NETWORKS=false
SCANNER_RESOLVE_DNS_FOR_SSRF=false # set true in production
SCANNER_TIMEOUT_SECONDS=8
SCANNER_MAX_RESPONSE_BYTES=512000
SCANNER_RATE_LIMIT_PROBE_COUNT=3
SCANNER_RATE_LIMIT_PROBE_DELAY_SECONDS=0.25

# Basic fixed-window API rate limiting.
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PUBLIC_REQUESTS=30
API_RATE_LIMIT_AUTHENTICATED_REQUESTS=300

